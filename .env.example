# Copy this file to .env and fill in real values. Never commit .env.

# Database. For an existing deployment, keep the user and database names it was created
# with (originally admin / thanksgiving). Changing POSTGRES_PASSWORD here does NOT change the
# password inside an existing database; see README "Changing the database password".
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=thanksgiving

# Shared secret the upload service sends to the display service's /notify endpoint.
# Any long random string, e.g. from:  python -c "import secrets; print(secrets.token_urlsafe(32))"
NOTIFY_TOKEN=replace-with-a-long-random-string

# Optional
# MAX_UPLOAD_MB=15
# DISPLAY_SERVICE_URL=http://display-server:5001
